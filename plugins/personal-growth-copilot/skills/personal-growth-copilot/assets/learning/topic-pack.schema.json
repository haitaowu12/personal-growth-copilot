                          "maxLength": 5000
                        }
                      },
                      "required": [
                        "id",
                        "text",
                        "feedback"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "correct": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "hint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "required": [
                  "prompt",
                  "choices",
                  "correct",
                  "hint"
                ],
                "additionalProperties": false
              },
              "transfer": {
