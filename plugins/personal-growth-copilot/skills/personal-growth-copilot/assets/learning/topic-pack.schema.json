                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "choices": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        },
                        "feedback": {
                          "type": "string",
