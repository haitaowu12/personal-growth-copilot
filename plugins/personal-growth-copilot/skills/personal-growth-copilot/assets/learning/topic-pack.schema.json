{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "review_days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 365
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "coverage": {
            "enum": [
              "selected-sections",
              "full-source"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "limits": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "section",
          "accessed",
          "coverage",
          "claim",
          "limits"
        ],
        "additionalProperties": false
      }
    },
    "content_notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "uniqueItems": true,
            "maxItems": 30
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "uniqueItems": true,
            "maxItems": 30,
            "minItems": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "misconception": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "example": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              }
            },
            "required": [
              "before",
              "after",
              "why"
            ],
            "additionalProperties": false
          },
          "questions": {
            "type": "object",
            "properties": {
              "diagnostic": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "choices": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,63}$"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        },
                        "feedback": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        }
                      },
                      "required": [
                        "id",
                        "text",
                        "feedback"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "correct": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "hint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "required": [
                  "prompt",
                  "choices",
                  "correct",
                  "hint"
                ],
                "additionalProperties": false
              },
