{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/release/exact-head-ci.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "status",
    "expected_sha",
    "checkout_sha",
    "qualification_source_commit",
    "qualification_sha256",
    "qualification_aggregate_sha256",
    "source_tree_clean",
    "generated_at",
    "workflow_ref",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "hosted-exact-head-ci"},
    "status": {"const": "PASS"},
    "expected_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checkout_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "qualification_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tree_clean": {"const": true},
    "generated_at": {"type": "string", "format": "date-time"},
    "workflow_ref": {"type": "string", "minLength": 1, "maxLength": 500},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
