{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/release/holdout-seal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "candidate_commit", "sealed_at", "public_case_count", "sealed_case_ids", "ciphertext_path", "ciphertext_sha256", "case_schema_path", "case_schema_sha256", "authors", "seal_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "holdout-seal"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "public_case_count": {"type": "integer", "minimum": 1},
    "sealed_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^holdout-[a-z0-9_-]{3,79}$"}
    },
    "ciphertext_path": {"type": "string", "minLength": 1, "maxLength": 500},
    "ciphertext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_schema_path": {"type": "string", "minLength": 1, "maxLength": 500},
    "case_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/author"}
    },
    "seal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_id", "subject_sha256", "identity_evidence_path", "identity_evidence_sha256", "independence_evidence_path", "independence_evidence_sha256", "authorship_evidence_path", "authorship_evidence_sha256", "independence_verified"],
      "properties": {
        "author_id": {"type": "string", "pattern": "^author-[0-9a-f]{16}$"},
        "subject_sha256": {"$ref": "#/$defs/hash"},
        "identity_evidence_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "identity_evidence_sha256": {"$ref": "#/$defs/hash"},
        "independence_evidence_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "independence_evidence_sha256": {"$ref": "#/$defs/hash"},
        "authorship_evidence_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "authorship_evidence_sha256": {"$ref": "#/$defs/hash"},
        "independence_verified": {"type": "boolean"}
      }
    }
  }
}
