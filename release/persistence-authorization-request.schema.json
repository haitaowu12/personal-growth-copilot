{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/release/persistence-authorization-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "payload", "key_id", "public_key_path", "public_key_sha256", "request_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "persistence-authorization-signing-request"},
    "payload": {"$ref": "persistence-authorization.schema.json#/$defs/payload"},
    "key_id": {"type": "string", "pattern": "^key-[0-9a-f]{16}$"},
    "public_key_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "public_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
