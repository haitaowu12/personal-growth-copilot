{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/release/reviewer-identity-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "reviewer_id", "subject_sha256", "issuer", "attested_at", "identity_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "reviewer-identity-attestation"},
    "reviewer_id": {"type": "string", "pattern": "^reviewer-[0-9a-f]{16}$"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 200},
    "attested_at": {"type": "string", "format": "date-time"},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
