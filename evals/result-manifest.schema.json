{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/result-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "suite_sha256", "config_sha256", "run_plan_sha256", "results", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "authored-target-result-manifest"},
    "suite_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "run_plan_sha256": {"$ref": "#/$defs/hash"},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_identity", "relative_path", "sha256"],
        "properties": {
          "run_identity": {"$ref": "#/$defs/runIdentity"},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 1000},
          "sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "system_id", "variant_id", "repetition"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "system_id": {"enum": ["target", "direct_assistant", "structured_reflection"]},
        "variant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "repetition": {"type": "integer", "minimum": 1}
      }
    }
  }
}
