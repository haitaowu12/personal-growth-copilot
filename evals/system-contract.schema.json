{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/system-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "systems"],
  "properties": {
    "$schema": {"const": "./system-contract.schema.json"},
    "schema_version": {"const": "1.0"},
    "systems": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/system"}
    }
  },
  "$defs": {
    "systemId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "relativePath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "profile_path",
        "bundle_paths",
        "context_policy",
        "memory_write_policy"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/systemId"},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "profile_path": {"$ref": "#/$defs/relativePath"},
        "bundle_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "context_policy": {
          "enum": ["CONVERSATION_ONLY", "READ_ONLY_USER_APPROVED"]
        },
        "memory_write_policy": {
          "enum": ["DISABLED", "HOST_EXPLICIT_ONLY"]
        }
      }
    }
  }
}
