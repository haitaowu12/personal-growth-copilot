{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/attempt-inventory-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "candidate_commit", "config_sha256", "run_plan_sha256", "entries", "index_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{15,99}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event_path", "event_sha256", "receipt_path", "receipt_sha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "event_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "receipt_path": {"type": "string", "minLength": 1, "maxLength": 500},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
