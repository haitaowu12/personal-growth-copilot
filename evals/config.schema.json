{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "frozen_at", "systems", "provider", "grader", "max_turns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "synthetic-conformance"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "systems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["target", "direct_assistant", "structured_reflection"]}
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "model", "adapter_version", "settings", "tool_permissions"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "settings": {"type": "object"},
        "tool_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "method"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "method": {"const": "synthetic_fixture"}
      }
    },
    "max_turns": {"type": "integer", "minimum": 4, "maximum": 50},
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
