{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/learning-content-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "qualification_claim_allowed", "candidate_commit", "topic_sha256", "reviewer_id", "identity_evidence_path", "identity_evidence_sha256", "independence_evidence_path", "independence_evidence_sha256", "reviewed_at", "source_accuracy_passed", "answer_key_passed", "rubric_alignment_passed", "known_issues", "review_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "learning-content-independent-review"},
    "qualification_claim_allowed": {"const": false},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "pattern": "^reviewer-[0-9a-f]{16}$"},
    "identity_evidence_path": {"$ref": "#/$defs/path"},
    "identity_evidence_sha256": {"$ref": "#/$defs/hash"},
    "independence_evidence_path": {"$ref": "#/$defs/path"},
    "independence_evidence_sha256": {"$ref": "#/$defs/hash"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "source_accuracy_passed": {"type": "boolean"},
    "answer_key_passed": {"type": "boolean"},
    "rubric_alignment_passed": {"type": "boolean"},
    "known_issues": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "review_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}
  }
}
