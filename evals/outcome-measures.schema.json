{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/outcome-measures.schema.json",
  "title": "Personal Growth Copilot outcome measurement design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "qualification_claim_allowed",
    "primary_outcome_ids",
    "measures",
    "comparator_plan",
    "interpretation_rules"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "evaluation-design-only"},
    "qualification_claim_allowed": {"const": false},
    "primary_outcome_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "measures": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/measure"}
    },
    "comparator_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_ablations", "planned_strong_comparators"],
      "properties": {
        "current_ablations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["direct_assistant", "structured_reflection"]}
        },
        "planned_strong_comparators": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["strong_generalist", "minimal_visible_model"]}
        }
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20, "maxLength": 500}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{4,79}$"},
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "role",
        "construct",
        "observation_source",
        "collection_points",
        "value_type",
        "success_interpretation",
        "adverse_or_null_interpretation",
        "claim_limit"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "layer": {"enum": ["process", "proximal", "delayed", "burden", "dependence"]},
        "role": {"enum": ["primary", "secondary", "guardrail"]},
        "construct": {"type": "string", "minLength": 20, "maxLength": 500},
        "observation_source": {
          "enum": ["user_confirmation", "user_entered_scale", "host_telemetry", "review_record", "human_review"]
        },
        "collection_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["pre_session", "post_session", "review_point", "end_of_pilot"]}
        },
        "value_type": {"enum": ["boolean", "ordinal", "count", "duration", "categorical"]},
        "anchors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 200}
        },
        "success_interpretation": {"type": "string", "minLength": 20, "maxLength": 500},
        "adverse_or_null_interpretation": {"type": "string", "minLength": 20, "maxLength": 500},
        "claim_limit": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    }
  }
}
