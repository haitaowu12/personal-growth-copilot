{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/results/target-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "qualification_claim_allowed", "source_commit", "suite_sha256", "config_sha256", "provider_identity_sha256", "run_plan_sha256", "planned_run_count", "campaign_complete", "run", "captures", "reviews", "quality", "aggregate_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "authored-target-run"},
    "qualification_claim_allowed": {"const": false},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "suite_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "provider_identity_sha256": {"$ref": "#/$defs/hash"},
    "run_plan_sha256": {"$ref": "#/$defs/hash"},
    "planned_run_count": {"type": "integer", "minimum": 1},
    "campaign_complete": {"const": false},
    "run": {"type": "object"},
    "captures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capture"}},
    "reviews": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/turnReview"}},
    "quality": {"$ref": "#/$defs/quality"},
    "aggregate_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewerId": {"type": "string", "pattern": "^reviewer-[0-9a-f]{16}$"},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_and_focus", "reflective_accuracy", "inquiry_quality", "context_model_integrity", "recommendation_fit", "experiment_quality", "agency_and_challenge", "continuity_and_privacy", "language_and_specificity", "anti_dependence", "safety_and_scope"],
      "properties": {
        "contract_and_focus": {"type": "integer", "minimum": 1, "maximum": 5},
        "reflective_accuracy": {"type": "integer", "minimum": 1, "maximum": 5},
        "inquiry_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "context_model_integrity": {"type": "integer", "minimum": 1, "maximum": 5},
        "recommendation_fit": {"type": "integer", "minimum": 1, "maximum": 5},
        "experiment_quality": {"type": "integer", "minimum": 1, "maximum": 5},
        "agency_and_challenge": {"type": "integer", "minimum": 1, "maximum": 5},
        "continuity_and_privacy": {"type": "integer", "minimum": 1, "maximum": 5},
        "language_and_specificity": {"type": "integer", "minimum": 1, "maximum": 5},
        "anti_dependence": {"type": "integer", "minimum": 1, "maximum": 5},
        "safety_and_scope": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "means": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_and_focus", "reflective_accuracy", "inquiry_quality", "context_model_integrity", "recommendation_fit", "experiment_quality", "agency_and_challenge", "continuity_and_privacy", "language_and_specificity", "anti_dependence", "safety_and_scope"],
      "properties": {
        "contract_and_focus": {"type": "number", "minimum": 1, "maximum": 5},
        "reflective_accuracy": {"type": "number", "minimum": 1, "maximum": 5},
        "inquiry_quality": {"type": "number", "minimum": 1, "maximum": 5},
        "context_model_integrity": {"type": "number", "minimum": 1, "maximum": 5},
        "recommendation_fit": {"type": "number", "minimum": 1, "maximum": 5},
        "experiment_quality": {"type": "number", "minimum": 1, "maximum": 5},
        "agency_and_challenge": {"type": "number", "minimum": 1, "maximum": 5},
        "continuity_and_privacy": {"type": "number", "minimum": 1, "maximum": 5},
        "language_and_specificity": {"type": "number", "minimum": 1, "maximum": 5},
        "anti_dependence": {"type": "number", "minimum": 1, "maximum": 5},
        "safety_and_scope": {"type": "number", "minimum": 1, "maximum": 5}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "role", "method", "language_fluent", "system_blinded", "events", "scores", "hard_failure_codes", "resource_claims_reviewed", "uncertainty", "submitted_at"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/reviewerId"},
        "role": {"enum": ["primary_1", "primary_2", "third_reviewer"]},
        "method": {"const": "human"},
        "language_fluent": {"type": "boolean"},
        "system_blinded": {"type": "boolean"},
        "events": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "scores": {"$ref": "#/$defs/scores"},
        "hard_failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resource_claims_reviewed": {"type": "boolean"},
        "uncertainty": {"enum": ["low", "medium", "high"]},
        "notes": {"type": "string", "maxLength": 2000},
        "submitted_at": {"type": "string", "format": "date-time"}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "adjudicator_id", "events", "scores", "hard_failure_codes", "resource_claims_reviewed", "disagreements", "decided_at"],
      "properties": {
        "method": {"enum": ["consensus", "third_reviewer"]},
        "adjudicator_id": {"$ref": "#/$defs/reviewerId"},
        "events": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "scores": {"$ref": "#/$defs/scores"},
        "hard_failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "resource_claims_reviewed": {"type": "boolean"},
        "disagreements": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 1000}},
        "decided_at": {"type": "string", "format": "date-time"}
      }
    },
    "turnReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "completion_sha256", "review_request_sha256", "review_sha256", "blinded_run_id", "identity_verification", "reviewers", "adjudication"],
      "properties": {
        "turn_id": {"type": "string"},
        "completion_sha256": {"$ref": "#/$defs/hash"},
        "review_request_sha256": {"$ref": "#/$defs/hash"},
        "review_sha256": {"$ref": "#/$defs/hash"},
        "blinded_run_id": {"type": "string", "pattern": "^blind_[0-9a-f]{32}$"},
        "identity_verification": {"const": "external_pending"},
        "reviewers": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/reviewer"}},
        "adjudication": {"$ref": "#/$defs/adjudication"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "request_sha256", "provider_identity_sha256", "provider_response_id", "captured_at", "completion_sha256"],
      "properties": {
        "turn_id": {"type": "string"},
        "request_sha256": {"$ref": "#/$defs/hash"},
        "provider_identity_sha256": {"$ref": "#/$defs/hash"},
        "provider_response_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "completion_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development_status", "identity_verification", "minimum_dimension_score", "minimum_overall_score", "dimension_means", "overall_mean", "agreement_method", "agreement_estimable", "agreement", "agreement_threshold", "failures"],
      "properties": {
        "development_status": {"enum": ["pass", "fail"]},
        "identity_verification": {"const": "external_pending"},
        "minimum_dimension_score": {"type": "number", "minimum": 1, "maximum": 5},
        "minimum_overall_score": {"type": "number", "minimum": 1, "maximum": 5},
        "dimension_means": {"$ref": "#/$defs/means"},
        "overall_mean": {"type": "number", "minimum": 1, "maximum": 5},
        "agreement_method": {"const": "weighted_kappa"},
        "agreement_estimable": {"type": "boolean"},
        "agreement": {"oneOf": [{"type": "number", "minimum": -1, "maximum": 1}, {"type": "null"}]},
        "agreement_threshold": {"const": 0.7},
        "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    }
  }
}
