{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/development-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "qualification_claim_allowed",
    "source_commit",
    "frozen_at",
    "suite_sha256",
    "target_config_sha256",
    "systems",
    "case_ids",
    "run_plan",
    "max_turns",
    "reviewer"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"const": "model-assisted-development"},
    "qualification_claim_allowed": {"const": false},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "suite_sha256": {"$ref": "#/$defs/hash"},
    "target_config_sha256": {"$ref": "#/$defs/hash"},
    "systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["target", "direct_assistant", "structured_reflection", "strong_generalist", "minimal_visible_model"]}
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "run_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/runIdentity"}
    },
    "max_turns": {"type": "integer", "minimum": 4, "maximum": 50},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "adapter_version",
        "adapter_sha256",
        "runtime_executable_sha256",
        "output_schema_sha256",
        "rubric_sha256",
        "host",
        "model",
        "model_version",
        "settings",
        "tool_permissions",
        "environment_allowlist"
      ],
      "properties": {
        "protocol": {"const": "pgc-model-review-v1"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "adapter_sha256": {"$ref": "#/$defs/hash"},
        "runtime_executable_sha256": {"$ref": "#/$defs/hash"},
        "output_schema_sha256": {"$ref": "#/$defs/hash"},
        "rubric_sha256": {"$ref": "#/$defs/hash"},
        "host": {"const": "codex-cli"},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra"]}
          }
        },
        "tool_permissions": {"type": "array", "maxItems": 0},
        "environment_allowlist": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["PGC_CODEX_AUTH_ROOT", "PGC_CODEX_BIN"]}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "system_id", "variant_id", "repetition"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "system_id": {"enum": ["target", "direct_assistant", "structured_reflection", "strong_generalist", "minimal_visible_model"]},
        "variant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "repetition": {"type": "integer", "minimum": 1}
      }
    }
  }
}
