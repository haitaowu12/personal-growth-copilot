{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-growth-copilot.local/evals/outcome-observations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "qualification_claim_allowed", "candidate_commit", "design_sha256", "generated_at", "episode_roster", "observations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"const": "product-outcome-observations"},
    "qualification_claim_allowed": {"const": false},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "episode_roster": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/episode"}},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "systemId": {"enum": ["target", "direct_assistant", "structured_reflection", "strong_generalist", "minimal_visible_model"]},
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "system_id", "participant_state"],
      "properties": {
        "episode_id": {"type": "string", "pattern": "^episode-[0-9a-f]{16}$"},
        "system_id": {"$ref": "#/$defs/systemId"},
        "participant_state": {"enum": ["COMPLETED", "WITHDRAWN", "DROPOUT", "ACTIVE"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "episode_id", "system_id", "measure_id", "collection_point", "status", "value", "observed_at", "evidence_path", "evidence_sha256"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^obs-[0-9a-f]{24}$"},
        "episode_id": {"type": "string", "pattern": "^episode-[0-9a-f]{16}$"},
        "system_id": {"$ref": "#/$defs/systemId"},
        "measure_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{4,79}$"},
        "collection_point": {"enum": ["pre_session", "post_session", "review_point", "end_of_pilot"]},
        "status": {"enum": ["OBSERVED", "MISSING", "DECLINED", "NOT_DUE"]},
        "value": {"type": ["string", "number", "integer", "boolean", "null"]},
        "observed_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "evidence_path": {"oneOf": [{"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, {"type": "null"}]},
        "evidence_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
      }
    }
  }
}
