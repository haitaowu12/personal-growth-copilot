{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/haitaowu12/personal-growth-copilot/evidence-supplement.schema.json","title":"Evidence review supplement","type":"object","additionalProperties":false,"required":["schema_version","review_date","status","policy","sources"],"properties":{"schema_version":{"const":"1.0"},"review_date":{"type":"string","format":"date"},"status":{"const":"candidate_supplement"},"policy":{"type":"string","minLength":1,"maxLength":2000},"sources":{"type":"array","minItems":5,"maxItems":100,"items":{"$ref":"#/$defs/source"}}},"$defs":{"source":{"type":"object","additionalProperties":false,"required":["id","type","citation","url","population","intervention","comparator","duration","outcomes","result","design_tier","risk_of_bias","directness","runtime_decision","limitation","conflicts_with","review_due"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"type":{"type":"string","minLength":1,"maxLength":120},"citation":{"type":"string","minLength":1,"maxLength":1000},"url":{"type":"string","format":"uri","pattern":"^https://"},"population":{"type":"string","minLength":1,"maxLength":1000},"intervention":{"type":"string","minLength":1,"maxLength":1000},"comparator":{"type":"string","minLength":1,"maxLength":1000},"duration":{"type":"string","minLength":1,"maxLength":700},"outcomes":{"type":"string","minLength":1,"maxLength":1200},"result":{"type":"string","minLength":1,"maxLength":1500},"design_tier":{"type":"string","minLength":1,"maxLength":120},"risk_of_bias":{"type":"string","minLength":1,"maxLength":1200},"directness":{"type":"string","minLength":1,"maxLength":300},"runtime_decision":{"enum":["add","retain","revise","defer","reject"]},"limitation":{"type":"string","minLength":1,"maxLength":1200},"conflicts_with":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]+$"}},"review_due":{"type":"string","format":"date"}}}}}
